{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'cd \"$CLAUDE_PROJECT_DIR\" && [ -x scripts/bootstrap.sh ] && ./scripts/bootstrap.sh >&2 || true'"
          }
        ]
      }
    ]
  }
}
