DATABASE_URL="file:./dev.db"
# Production: libsql://<db>-<org>.turso.io (see docs/PRODUCTION-ENV-CHECKLIST.md
# Section 1).
# Required when DATABASE_URL is a remote libsql URL; ignored for file: URLs.
# Generate via Turso CLI: turso db tokens create <db-name>
TURSO_AUTH_TOKEN=""

# Generate via: openssl rand -base64 32
# NEVER reuse the dev secret in production.
AUTH_SECRET=""

# GitHub OAuth (B8). Optional sign-in path alongside credentials.
# Register at https://github.com/settings/developers with callback URL
# ${NEXT_PUBLIC_APP_URL}/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Bearer token the cron processor expects in the Authorization header.
# Generate via: openssl rand -base64 32
# Without it, cron unconditionally returns 401 → emails never send.
CRON_SECRET=""

# Resend — email infrastructure (B3).
# Without RESEND_API_KEY, queued email tasks log + permanently-skip on
# the first cron tick (see src/app/api/cron/process-tasks). The booking
# flow is unaffected. Sign up at https://resend.com.
RESEND_API_KEY=""
EMAIL_FROM="Officehours <onboarding@resend.dev>"
# Optional dev inbox redirect. Set to your own email and every dev
# send (reminders, invites, magic links) routes to your inbox instead
# of Resend's `delivered@resend.dev` sink. Production ignores this —
# actual recipient is always used when VERCEL_ENV=production.
EMAIL_DEV_REDIRECT=""

# Public app URL for outbound emails (confirmation links). Falls back
# to http://localhost:3001 in dev. Production: https://<your-domain>
# (no trailing slash).
NEXT_PUBLIC_APP_URL=""

# Calendar OAuth (B5/B9). Both providers are optional — without
# credentials, the calendar Connect flow returns a "not configured"
# message and slot generation falls back to ignoring busy times. The
# adapter shape is identical when either is enabled, so adding one
# provider doesn't require the other.
# Register at https://console.cloud.google.com/apis/credentials with
# redirect URI: ${NEXT_PUBLIC_APP_URL}/api/auth/calendar/google/callback
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
# Register at https://entra.microsoft.com/ → App Registrations with
# redirect URI: ${NEXT_PUBLIC_APP_URL}/api/auth/calendar/microsoft/callback
# Tenant: "common" works for both personal and work accounts.
MICROSOFT_OAUTH_CLIENT_ID=""
MICROSOFT_OAUTH_CLIENT_SECRET=""

# AES-256-GCM key for encrypting CalendarCredential.accessToken +
# refreshToken at rest. 32 bytes hex-encoded (64 chars). Generate with:
#   node -e 'console.log(require("crypto").randomBytes(32).toString("hex"))'
# Required when GOOGLE_OAUTH_* / MICROSOFT_OAUTH_* are in use.
CALENDAR_TOKEN_KEY=""

# Stripe billing (B6). Live mode keys (sk_live_*) for production;
# test mode (sk_test_*) for staging. Test-mode keys MUST NOT ship
# to prod.
# Source: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=""
# Price IDs for each plan tier. Create products at
# https://dashboard.stripe.com/products then copy each price's id.
STRIPE_PRICE_PRO=""
STRIPE_PRICE_TEAM=""
# Webhook signing secret. Source: Stripe Dashboard → Developers →
# Webhooks → add endpoint at ${NEXT_PUBLIC_APP_URL}/api/billing/webhook
# → reveal signing secret (whsec_...).
STRIPE_WEBHOOK_SECRET=""

# Sentry observability (B7). Without NEXT_PUBLIC_SENTRY_DSN, the
# withSpan observability falls back to console.log.
# DSN: client + server-runtime reporting. Public — ships to browser.
# Source: Sentry → Project Settings → Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=""
# Build-time only. Used by withSentryConfig in next.config.ts to
# upload source maps on each prod deploy.
# Source: Sentry → Settings → Account → Auth Tokens → Create Token
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# CSV of host handles permitted to access /admin/* (B10). Empty/unset
# → no admin access from any account.
OFFICEHOURS_ADMIN_HANDLES=""

# Upstash Redis fallback for multi-region rate-limiting (B11). Without
# both vars, the in-memory limiter is used (per-instance — fine for
# single-region serverless).
# Source: https://console.upstash.com → Create Database → REST API tab
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
