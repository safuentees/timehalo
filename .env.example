DATABASE_URL="file:./dev.db"

AUTH_SECRET=""

AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Resend — email infrastructure (A1).
# Without RESEND_API_KEY, queued email tasks log + permanently-skip on
# the first cron tick (see src/app/api/cron/process-tasks). The booking
# flow is unaffected. Sign up at https://resend.com.
RESEND_API_KEY=""
EMAIL_FROM="Officehours <onboarding@resend.dev>"

# Public app URL for outbound emails (confirmation links). Falls back
# to http://localhost:3000 in dev.
NEXT_PUBLIC_APP_URL=""

# Calendar OAuth (B3). Both providers are optional — without
# credentials, the calendar Connect flow returns a "not configured"
# message and slot generation falls back to ignoring busy times. The
# adapter shape is identical when either is enabled, so adding one
# provider doesn't require the other.
# Register at https://console.cloud.google.com/apis/credentials with
# redirect URI: ${NEXT_PUBLIC_APP_URL}/api/auth/calendar/google/callback
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
# Register at https://entra.microsoft.com/ → App Registrations with
# redirect URI: ${NEXT_PUBLIC_APP_URL}/api/auth/calendar/microsoft/callback
# Tenant: "common" works for both personal and work accounts.
MICROSOFT_OAUTH_CLIENT_ID=""
MICROSOFT_OAUTH_CLIENT_SECRET=""

# AES-256-GCM key for encrypting CalendarCredential.accessToken +
# refreshToken at rest. 32 bytes hex-encoded (64 chars). Generate with:
#   node -e 'console.log(require("crypto").randomBytes(32).toString("hex"))'
# Required when GOOGLE_OAUTH_* / MICROSOFT_OAUTH_* are in use.
CALENDAR_TOKEN_KEY=""
