generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                   String              @id @default(cuid())
  name                 String?
  email                String              @unique
  emailVerified        DateTime?
  image                String?
  passwordHash         String?
  invalidLoginAttempts Int                 @default(0)
  handle               String?             @unique
  availabilityRanges   AvailabilityRange[]
  accounts             Account[]
  sessions             Session[]
  Authenticator        Authenticator[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  bookings             Booking[]
  webhooks             WebhookSubscription[]
  features             UserFeatures[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?
  user                 User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

model Booking {
  id           Int      @id @default(autoincrement())
  publicUid    String   @unique @default(cuid())
  host         User     @relation(fields: [hostId], references: [id], onDelete: Cascade)
  hostId       String
  visitorName  String
  visitorEmail String
  question     String?
  slotStart    DateTime
  slotEnd      DateTime
  referrer     String?
  idempotencyKey String? @unique
  createdAt    DateTime @default(now())
  deleted      Boolean  @default(false)
  deletedAt    DateTime?

  @@index([hostId, slotStart, deleted])
  @@index([deleted, deletedAt])
}

model BookingAudit {
  id          Int                 @id @default(autoincrement())
  bookingUid  String              // intentionally NOT FK
  actor       AuditActor
  action      BookingAuditAction
  data        Json                // snapshot of the new state
  operationId String
  createdAt   DateTime            @default(now())

  @@index([bookingUid])
  @@index([operationId])
}

enum AuditActor {
  VISITOR
  HOST
  SYSTEM
}

enum BookingAuditAction {
  CREATED
  CONFIRMED
  CANCELLED
}

model Feature {
  slug        String      @id
  enabled     Boolean     @default(false)
  description String?
  type        FeatureType @default(RELEASE)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  assignments UserFeatures[]

  @@index([enabled])
}

model UserFeatures {
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  feature     Feature @relation(fields: [featureSlug], references: [slug], onDelete: Cascade)
  featureSlug String
  assignedAt  DateTime @default(now())
  assignedBy  String?

  @@id([userId, featureSlug])
  @@index([featureSlug])
}

enum FeatureType {
  RELEASE      // staged rollout of a new feature
  EXPERIMENT   // A/B test gate
  OPERATIONAL  // structural toggle (caching, batching)
  KILL_SWITCH  // emergency off-switch for an existing feature
  PERMISSION   // long-lived gate per role / plan / cohort
}

model WebhookSubscription {
  id            Int      @id @default(autoincrement())
  publicUid     String   @unique @default(cuid())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  subscriberUrl String
  secret        String   // hex-encoded 32 random bytes; HMAC SHA-256 key
  events        String   // CSV: "booking.created,booking.confirmed"
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, active])
}

model Task {
  id                   Int       @id @default(autoincrement())
  type                 String    // "webhookDelivery" for now
  payload              String    // JSON.stringify of { webhookSubscriptionId, event, body }
  scheduledAt          DateTime  @default(now())
  succeededAt          DateTime?
  attempts             Int       @default(0)
  maxAttempts          Int       @default(3)
  lastError            String?
  lastFailedAttemptAt  DateTime?
  referenceUid         String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([referenceUid, type])
  @@index([succeededAt])
  @@index([scheduledAt, succeededAt])
}

model AvailabilityRange {
  id        Int       @id @default(autoincrement())
  userId    String
  dayOfWeek DayOfWeek
  startTime String
  endTime   String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dayOfWeek])
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}
