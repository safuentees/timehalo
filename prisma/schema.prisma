generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                   String              @id @default(cuid())
  name                 String?
  email                String              @unique
  emailVerified        DateTime?
  image                String?
  passwordHash         String?
  invalidLoginAttempts Int                 @default(0)
  handle               String?             @unique
  availabilityRanges   AvailabilityRange[]
  accounts             Account[]
  sessions             Session[]
  Authenticator        Authenticator[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  bookings             Booking[]
  webhooks             WebhookSubscription[]
  features             UserFeatures[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?
  user                 User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

// A visitor's confirmed 15-minute slot with a host. Visitors are not
// authenticated — `visitorName` / `visitorEmail` are plain text from the
// booking form. `@@unique([hostId, slotStart])` is the double-book
// guard: two concurrent bookings for the same host at the same minute
// trip the unique constraint and surface as a tRPC CONFLICT error.
model Booking {
  id           Int      @id @default(autoincrement())
  publicUid    String   @unique @default(cuid())
  host         User     @relation(fields: [hostId], references: [id], onDelete: Cascade)
  hostId       String
  visitorName  String
  visitorEmail String
  question     String?
  slotStart    DateTime
  slotEnd      DateTime
  // Attribution captured at booking time from the oh_ref_<handle>
  // cookie (set by proxy.ts when the visitor lands via a ?ref= link).
  // Plain string ("twitter", "newsletter", etc.) — no PII. Mirrors
  // dub.co's per-link attribution thread (apps/web/lib/middleware/
  // utils/create-response-with-cookies.ts) shrunk to single-host scope.
  referrer     String?
  // Client-supplied UUID generated once at form mount. Same key on every
  // retry of the same submit — second create with the same key is
  // intercepted by the handler and returns the original booking instead
  // of throwing. Mirrors cal.com Booking.idempotencyKey
  // (packages/prisma/schema.prisma:855). Nullable for legacy / future
  // server-side creates that don't need a per-attempt key. Also set to
  // null on soft-delete so a future booking can reuse the key (NULL
  // values don't trigger the unique constraint per SQL standard).
  idempotencyKey String? @unique
  createdAt    DateTime @default(now())
  // Soft-delete columns (rallly's pattern at packages/database/prisma/
  // models/poll.prisma:30-31). Reads filter `deleted: false`; the
  // cleanup cron hard-deletes rows past a retention window.
  deleted      Boolean  @default(false)
  deletedAt    DateTime?

  // The previous `@@unique([hostId, slotStart])` was dropped — soft-
  // deleted rows still occupy the slot from the constraint's view,
  // which would block legitimate rebooking. SQLite has no partial
  // unique indexes; we enforce "no two ACTIVE bookings at the same
  // slot" inside the bookings.create transaction (findFirst with
  // `deleted: false` then create, atomic under SQLite's write lock).
  // The composite index speeds that read.
  @@index([hostId, slotStart, deleted])
  @@index([deleted, deletedAt])
}

// Append-only history of every state change on a booking. Mirrors
// cal.com BookingAudit (packages/prisma/schema.prisma:2486+) — crucial
// design choice: NO foreign key to Booking. `bookingUid` is a plain
// string so audit rows survive booking deletion (GDPR delete, manual
// cleanup, future soft-delete cron). The actor enum + action enum +
// JSON snapshot make every row self-contained — you can answer "what
// did this booking look like at this moment, and who changed it" even
// after the booking row is gone.
//
// `operationId` correlates cascading writes from one user action: the
// audit row, future webhook delivery rows, future email send rows all
// share an operationId so logs can group "everything that happened
// because the visitor clicked submit at 14:32:01."
model BookingAudit {
  id          Int                 @id @default(autoincrement())
  bookingUid  String              // intentionally NOT FK
  actor       AuditActor
  action      BookingAuditAction
  data        Json                // snapshot of the new state
  operationId String
  createdAt   DateTime            @default(now())

  @@index([bookingUid])
  @@index([operationId])
}

enum AuditActor {
  VISITOR
  HOST
  SYSTEM
}

enum BookingAuditAction {
  CREATED
  CONFIRMED
  CANCELLED
}

// Feature flags. Mirrors cal.com Feature
// (packages/prisma/schema.prisma:1370-1426) at smaller scale — no
// teams, no `stale` tracking, no last-used auditing. The slug IS the
// PK because slugs are stable, human-readable identifiers
// ("live-queue", "experimental-host-page-v2") that code references
// directly. enabled=false on a row = killed for everyone.
//
// Per-user overrides live in UserFeatures: presence of a row scopes
// the feature to those users only. Absence with enabled=true = global.
model Feature {
  slug        String      @id
  enabled     Boolean     @default(false)
  description String?
  type        FeatureType @default(RELEASE)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  assignments UserFeatures[]

  @@index([enabled])
}

// Join table — one row per (user, feature) assignment. The mere
// existence of the row IS the assignment; we don't store a per-row
// `enabled` boolean (cal.com does for finer toggling, but at our scale
// "delete the row to revoke" is simpler).
model UserFeatures {
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  feature     Feature @relation(fields: [featureSlug], references: [slug], onDelete: Cascade)
  featureSlug String
  assignedAt  DateTime @default(now())
  assignedBy  String?

  @@id([userId, featureSlug])
  @@index([featureSlug])
}

// Categorization for admin UIs (when we have one). Runtime check
// doesn't branch on type — both kill switches and releases are just
// "is this slug enabled for this user?" The label is for humans.
enum FeatureType {
  RELEASE      // staged rollout of a new feature
  EXPERIMENT   // A/B test gate
  OPERATIONAL  // structural toggle (caching, batching)
  KILL_SWITCH  // emergency off-switch for an existing feature
  PERMISSION   // long-lived gate per role / plan / cohort
}

// Outbound webhook a host registers — when a booking event fires, the
// scheduler writes a Task row pointing at this subscription. The secret
// is generated server-side at create time and shown to the host once
// (we never display it again — they have to keep it). Mirrors cal.com
// Webhook (packages/prisma/schema.prisma:1143).
//
// `events` is a CSV of event names ("booking.created,booking.confirmed").
// CSV instead of a join table because cal.com does the same for the
// same reasons: the cardinality is small, exact-match query is a
// simple LIKE / contains, and migrations stay simple.
model WebhookSubscription {
  id            Int      @id @default(autoincrement())
  publicUid     String   @unique @default(cuid())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  subscriberUrl String
  secret        String   // hex-encoded 32 random bytes; HMAC SHA-256 key
  events        String   // CSV: "booking.created,booking.confirmed"
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, active])
}

// Generic background job — single shape covers webhook delivery today
// and (later) email send / reminder dispatch / reconciliation runs.
// Mirrors cal.com Task (packages/prisma/schema.prisma:1826-1852)
// almost field-for-field. `payload` is JSON-stringified by the caller
// so this table doesn't depend on Prisma Json adapter quirks across
// SQLite / Postgres.
//
// A task is "due" when `scheduledAt <= now() AND succeededAt IS NULL
// AND attempts < maxAttempts`. Permanently failed when `attempts >=
// maxAttempts AND succeededAt IS NULL` — no separate failedAt column,
// the attempt counter is the state machine.
//
// `@@unique([referenceUid, type])` is the dedup mechanism — if the
// same delivery gets scheduled twice (race in scheduler, retry on
// the trigger side), the second insert hits the constraint and the
// caller can swallow it as "already scheduled."
model Task {
  id                   Int       @id @default(autoincrement())
  type                 String    // "webhookDelivery" for now
  payload              String    // JSON.stringify of { webhookSubscriptionId, event, body }
  scheduledAt          DateTime  @default(now())
  succeededAt          DateTime?
  attempts             Int       @default(0)
  maxAttempts          Int       @default(3)
  lastError            String?
  lastFailedAttemptAt  DateTime?
  referenceUid         String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([referenceUid, type])
  @@index([succeededAt])
  @@index([scheduledAt, succeededAt])
}

// A single time window on a specific day of the week. A user can have many
// ranges per day (e.g. 09:00–12:00 and 14:00–17:00). Days with no ranges
// are implicitly "off" — the form's `enabled: false` maps to "no rows for
// that day". Times are stored as "HH:MM" (24-hour) to match the form's
// native `<input type="time">` output.
model AvailabilityRange {
  id        Int       @id @default(autoincrement())
  userId    String
  dayOfWeek DayOfWeek
  startTime String
  endTime   String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dayOfWeek])
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}
