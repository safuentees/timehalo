generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                   String              @id @default(cuid())
  name                 String?
  email                String              @unique
  emailVerified        DateTime?
  image                String?
  passwordHash         String?
  invalidLoginAttempts Int                 @default(0)
  handle               String?             @unique
  // Public-profile bio (B.PT??). Renders on /h/<handle> below the
  // host's name. Optional; max 500 chars enforced at the procedure
  // layer (zod), not in the schema — Prisma SQLite doesn't have a
  // native length constraint and the friendlier zod error path is
  // worth the duplication. Cal.com's equivalent `User.bio` is also
  // optional, with their length cap (~1500) in tRPC schema not
  // Prisma. We chose 500 as the cap because the visitor surface
  // wants a scannable elevator-pitch, not long-form copy.
  bio                  String?
  // IANA timezone for the host's wall-clock interpretation. Drives
  // how AvailabilityRange.startTime/endTime get mapped to UTC slots.
  // Default "UTC" is the historical no-op behavior — every host has
  // an explicit zone after this migration.
  timezone             String              @default("UTC")
  // Onboarding checklist state (B.PT43). The /bookings inline
  // checklist surfaces 5 setup steps; `dismissed` tracks the X-click,
  // `manualSteps` tracks step ids the host marked complete by hand
  // (currently just "share"). Stored on the User row instead of
  // localStorage so SSR can read them — without server-readable
  // state, the checklist server-renders with the wrong done flags
  // and visibly snaps post-hydration. JSON-string for the array
  // (SQLite has no native array type); parsed in `users.me`.
  onboardingDismissed  Boolean             @default(false)
  onboardingManualSteps String             @default("[]")
  availabilityRanges   AvailabilityRange[]
  accounts             Account[]
  sessions             Session[]
  Authenticator        Authenticator[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  bookings             Booking[]
  webhooks             WebhookSubscription[]
  features             UserFeatures[]
  // Workspace primitives (B1). Existing booking flow stays user-
  // centric; workspaces are an additional layer for collaboration.
  ownedWorkspaces      Workspace[]         @relation("OwnedWorkspaces")
  memberships          Membership[]
  // Calendar OAuth credentials (B3). Per-user, per-provider; cascade
  // delete with the user.
  calendarCredentials  CalendarCredential[]
  // Automation rules (B4) — user-configurable triggers that
  // generalize A8's hardcoded reminder pattern.
  workflows            Workflow[]
  // Event-type pool memberships (B2). A user can be a host on many
  // event types across the workspaces they're a member of. Each
  // membership row carries the round-robin metadata (priority,
  // weight, recentAssignments) the selection algorithm consumes.
  eventTypeHosts       EventTypeHost[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?
  user                 User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

// A visitor's confirmed 15-minute slot with a host. Visitors are not
// authenticated — `visitorName` / `visitorEmail` are plain text from the
// booking form. `@@unique([hostId, slotStart])` is the double-book
// guard: two concurrent bookings for the same host at the same minute
// trip the unique constraint and surface as a tRPC CONFLICT error.
model Booking {
  id           Int      @id @default(autoincrement())
  publicUid    String   @unique @default(cuid())
  host         User     @relation(fields: [hostId], references: [id], onDelete: Cascade)
  hostId       String
  // Workspace this booking belongs to. Denormalized from the host's
  // primary owned Workspace at create time so booking reads can scope
  // to a workspace without a User join. Cascading delete with the
  // Workspace mirrors the existing host cascade — closing a workspace
  // closes its bookings. Backfill landed in 20260427_workspace_aware_
  // bookings: every existing host got a Workspace + OWNER Membership
  // and every Booking row was stamped with the host's workspace.id.
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId  String
  visitorName  String
  visitorEmail String
  question     String?
  slotStart    DateTime
  slotEnd      DateTime
  // Visitor's IANA timezone captured at booking time. Stays nullable
  // for forward-compat — old rows or programmatic creates can omit
  // it. Used for confirmation-page display + future reminder emails
  // localized to the visitor.
  visitorTimezone String?
  // Reschedule chain — points back at the booking this one replaced.
  // No FK, plain string (cal.com pattern packages/prisma/schema.prisma:
  // 855 area). When a visitor reschedules, the previous booking is
  // soft-deleted and this column links the new row to the old uid so
  // the audit trail is queryable in either direction.
  rescheduledFromUid String?
  // Attribution captured at booking time from the oh_ref_<handle>
  // cookie (set by proxy.ts when the visitor lands via a ?ref= link).
  // Plain string ("twitter", "newsletter", etc.) — no PII. Mirrors
  // dub.co's per-link attribution thread (apps/web/lib/middleware/
  // utils/create-response-with-cookies.ts) shrunk to single-host scope.
  referrer     String?
  // Client-supplied UUID generated once at form mount. Same key on every
  // retry of the same submit — second create with the same key is
  // intercepted by the handler and returns the original booking instead
  // of throwing. Mirrors cal.com Booking.idempotencyKey
  // (packages/prisma/schema.prisma:855). Nullable for legacy / future
  // server-side creates that don't need a per-attempt key. Also set to
  // null on soft-delete so a future booking can reuse the key (NULL
  // values don't trigger the unique constraint per SQL standard).
  idempotencyKey String? @unique
  // Event type the booking was made against (B2). Nullable for
  // forward-compat with rows created before this column landed. New
  // bookings always stamp it from the EventType resolved by handle.
  // No SetNull / Cascade — when an event type is deleted, its
  // bookings keep their archive value (the EventType row may live on
  // soft-deleted, future iteration). Index supports
  // workspaces.apiKeys-style "list bookings for an event type" reads.
  eventTypeId  String?
  eventType    EventType? @relation(fields: [eventTypeId], references: [id], onDelete: SetNull)
  // Two-way calendar write (B2). When the host has a connected
  // calendar, bookings.create enqueues a Task that POSTs to the
  // provider; on success, externalCalendarEventId stores the
  // provider's event id and externalCalendarCredentialId records
  // which credential was used. bookings.cancel deletes that event;
  // bookings.reschedule updates it. Both columns nullable —
  // bookings for hosts without a connected calendar simply skip
  // the calendar-write side. SetNull on credential delete so the
  // booking row keeps its history even if the host disconnects.
  externalCalendarEventId      String?
  externalCalendarCredentialId String?
  externalCalendarCredential   CalendarCredential? @relation(fields: [externalCalendarCredentialId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  // Soft-delete columns (rallly's pattern at packages/database/prisma/
  // models/poll.prisma:30-31). Reads filter `deleted: false`; the
  // cleanup cron hard-deletes rows past a retention window.
  deleted      Boolean  @default(false)
  deletedAt    DateTime?

  // The previous `@@unique([hostId, slotStart])` was dropped — soft-
  // deleted rows still occupy the slot from the constraint's view,
  // which would block legitimate rebooking. SQLite has no partial
  // unique indexes; we enforce "no two ACTIVE bookings at the same
  // slot" inside the bookings.create transaction (findFirst with
  // `deleted: false` then create, atomic under SQLite's write lock).
  // The composite index speeds that read.
  @@index([hostId, slotStart, deleted])
  @@index([deleted, deletedAt])
  @@index([workspaceId, slotStart])
  @@index([eventTypeId, slotStart])
}

// Bookable resource (B2). Every workspace has one or more event
// types. Backfill: every pre-existing User got a singleton EventType
// keyed off their handle, with themselves as the only fixed host.
// Multi-host workspaces add additional EventTypeHost rows with
// isFixed=false and the round-robin metadata (priority, weight)
// flips on automatically.
model EventType {
  id           String          @id @default(cuid())
  workspaceId  String
  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Public slug — for the singleton-per-user backfill, this matches
  // the host's User.handle so existing /h/<handle> URLs keep
  // resolving without a routing change. Multi-host event types pick
  // their own slug. @@unique on (workspaceId, slug) so two workspaces
  // can each have a "consult" event type.
  slug         String
  name         String
  durationMins Int             @default(15)
  // B.PT158 — visitor-selectable duration allow-list. JSON-stringified
  // Int[] (SQLite has no array type; same pattern as User.onboarding
  // ManualSteps). Empty `[]` falls back to single-duration behavior —
  // bookings.create + the /h/[handle] chip strip use durationMins.
  // When non-empty, the chip strip renders one chip per minute value
  // and bookings.create validates the visitor's pick is in the list.
  durationMinsList String       @default("[]")
  hosts        EventTypeHost[]
  bookings     Booking[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([workspaceId, slug])
  @@index([workspaceId])
}

// Membership of a User in an EventType's host pool. The round-robin
// algorithm in src/lib/round-robin.ts consumes priority + weight +
// recentAssignments straight off these rows. isFixed=true marks
// "must be present" hosts (cal.com's pattern); the remaining
// not-fixed members form the rotation pool.
model EventTypeHost {
  id                String    @id @default(cuid())
  eventTypeId       String
  eventType         EventType @relation(fields: [eventTypeId], references: [id], onDelete: Cascade)
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  isFixed           Boolean   @default(false)
  priority          Int       @default(2)
  weight            Int       @default(1)
  // Lookback counter for fairness. The booking flow increments it
  // every time this host is picked; a future cleanup-cron resets it
  // on a 30d window. Plain integer to avoid timezone math.
  recentAssignments Int       @default(0)
  createdAt         DateTime  @default(now())

  @@unique([eventTypeId, userId])
  @@index([userId])
}

// Append-only history of every state change on a booking. Mirrors
// cal.com BookingAudit (packages/prisma/schema.prisma:2486+) — crucial
// design choice: NO foreign key to Booking. `bookingUid` is a plain
// string so audit rows survive booking deletion (GDPR delete, manual
// cleanup, future soft-delete cron). The actor enum + action enum +
// JSON snapshot make every row self-contained — you can answer "what
// did this booking look like at this moment, and who changed it" even
// after the booking row is gone.
//
// `operationId` correlates cascading writes from one user action: the
// audit row, future webhook delivery rows, future email send rows all
// share an operationId so logs can group "everything that happened
// because the visitor clicked submit at 14:32:01."
model BookingAudit {
  id          Int                 @id @default(autoincrement())
  bookingUid  String              // intentionally NOT FK
  // Workspace this audit row belongs to (B1). Denormalized at
  // write time from `Booking.workspaceId` so workspace-level audit
  // views are a one-query scan. Nullable + onDelete: SetNull
  // because audit rows must survive workspace deletion (and the
  // user-cascade chain User→Workspace→Audit) — same forensic
  // invariant that keeps `bookingUid` an FK-less plain string.
  // When the workspace is gone, the column nulls out; the audit
  // row stays. New audits always carry a non-null workspaceId
  // (procedure writers set it from Booking.workspaceId).
  workspaceId String?
  workspace   Workspace?          @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  actor       AuditActor
  action      BookingAuditAction
  data        Json                // snapshot of the new state
  operationId String
  createdAt   DateTime            @default(now())

  @@index([bookingUid])
  @@index([operationId])
  @@index([workspaceId, createdAt])
}

enum AuditActor {
  VISITOR
  HOST
  SYSTEM
}

enum BookingAuditAction {
  CREATED
  CONFIRMED
  CANCELLED
  // The OLD booking gets RESCHEDULED_FROM (paired with operationId);
  // the NEW booking gets RESCHEDULED_TO with the same operationId.
  // Pairing by operationId makes "show the reschedule chain for
  // booking X" a one-query answer.
  RESCHEDULED_FROM
  RESCHEDULED_TO
}

// Feature flags. Mirrors cal.com Feature
// (packages/prisma/schema.prisma:1370-1426) at smaller scale — no
// teams, no `stale` tracking, no last-used auditing. The slug IS the
// PK because slugs are stable, human-readable identifiers
// ("live-queue", "experimental-host-page-v2") that code references
// directly. enabled=false on a row = killed for everyone.
//
// Per-user overrides live in UserFeatures: presence of a row scopes
// the feature to those users only. Absence with enabled=true = global.
model Feature {
  slug        String      @id
  enabled     Boolean     @default(false)
  description String?
  type        FeatureType @default(RELEASE)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  assignments UserFeatures[]

  @@index([enabled])
}

// Join table — one row per (user, feature) assignment. The mere
// existence of the row IS the assignment; we don't store a per-row
// `enabled` boolean (cal.com does for finer toggling, but at our scale
// "delete the row to revoke" is simpler).
model UserFeatures {
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  feature     Feature @relation(fields: [featureSlug], references: [slug], onDelete: Cascade)
  featureSlug String
  assignedAt  DateTime @default(now())
  assignedBy  String?

  @@id([userId, featureSlug])
  @@index([featureSlug])
}

// Categorization for admin UIs (when we have one). Runtime check
// doesn't branch on type — both kill switches and releases are just
// "is this slug enabled for this user?" The label is for humans.
enum FeatureType {
  RELEASE      // staged rollout of a new feature
  EXPERIMENT   // A/B test gate
  OPERATIONAL  // structural toggle (caching, batching)
  KILL_SWITCH  // emergency off-switch for an existing feature
  PERMISSION   // long-lived gate per role / plan / cohort
}

// Outbound webhook a host registers — when a booking event fires, the
// scheduler writes a Task row pointing at this subscription. The secret
// is generated server-side at create time and shown to the host once
// (we never display it again — they have to keep it). Mirrors cal.com
// Webhook (packages/prisma/schema.prisma:1143).
//
// `events` is a CSV of event names ("booking.created,booking.confirmed").
// CSV instead of a join table because cal.com does the same for the
// same reasons: the cardinality is small, exact-match query is a
// simple LIKE / contains, and migrations stay simple.
model WebhookSubscription {
  id            Int      @id @default(autoincrement())
  publicUid     String   @unique @default(cuid())
  // Creator (B1). Kept alongside workspaceId so the audit trail of
  // "who minted this subscription" survives — but ownership /
  // access-control flows through workspace membership scope, not
  // userId. `userId` cascade matches the legacy contract; in
  // practice deleting the user implies deleting their workspace
  // memberships first, which already cascades the subscription.
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  // Workspace this webhook is scoped to (B1). Webhooks now live on
  // a workspace; OWNER/ADMIN with `webhooks.write` can manage
  // them. Backfilled in 20260429_workspace_aware_webhooks_audit
  // from each creator's primary owned workspace.
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId   String
  subscriberUrl String
  secret        String   // hex-encoded 32 random bytes; HMAC SHA-256 key
  events        String   // CSV: "booking.created,booking.confirmed"
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, active])
  @@index([workspaceId, active])
}

// Generic background job — single shape covers webhook delivery today
// and (later) email send / reminder dispatch / reconciliation runs.
// Mirrors cal.com Task (packages/prisma/schema.prisma:1826-1852)
// almost field-for-field. `payload` is JSON-stringified by the caller
// so this table doesn't depend on Prisma Json adapter quirks across
// SQLite / Postgres.
//
// A task is "due" when `scheduledAt <= now() AND succeededAt IS NULL
// AND attempts < maxAttempts`. Permanently failed when `attempts >=
// maxAttempts AND succeededAt IS NULL` — no separate failedAt column,
// the attempt counter is the state machine.
//
// `@@unique([referenceUid, type])` is the dedup mechanism — if the
// same delivery gets scheduled twice (race in scheduler, retry on
// the trigger side), the second insert hits the constraint and the
// caller can swallow it as "already scheduled."
model Task {
  id                   Int       @id @default(autoincrement())
  type                 String    // "webhookDelivery" for now
  payload              String    // JSON.stringify of { webhookSubscriptionId, event, body }
  scheduledAt          DateTime  @default(now())
  succeededAt          DateTime?
  attempts             Int       @default(0)
  maxAttempts          Int       @default(3)
  lastError            String?
  lastFailedAttemptAt  DateTime?
  // HTTP response status from the LAST attempt. Populated by the cron
  // processor on every webhookDelivery dispatch — both success (2xx,
  // booking-detail surfaces ✓ green) and failure (4xx/5xx, surfaced
  // ✗ red). Null for non-network task types (emailSend, calendarWrite)
  // since those don't have a meaningful HTTP status to expose. Per
  // dub.co's webhook-event tinybird shape (http_status field) — the
  // modern pattern is to record the actual receiver response so the
  // host can debug a "delivered but 400" mismatch instead of inferring
  // success from the absence of an error.
  lastResponseStatus   Int?
  referenceUid         String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([referenceUid, type])
  @@index([succeededAt])
  @@index([scheduledAt, succeededAt])
}

// A single time window on a specific day of the week. A user can have many
// ranges per day (e.g. 09:00–12:00 and 14:00–17:00). Days with no ranges
// are implicitly "off" — the form's `enabled: false` maps to "no rows for
// that day". Times are stored as "HH:MM" (24-hour) to match the form's
// native `<input type="time">` output.
model AvailabilityRange {
  id        Int       @id @default(autoincrement())
  userId    String
  dayOfWeek DayOfWeek
  startTime String
  endTime   String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dayOfWeek])
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

// Workspace primitives (B1). Pattern reference: cal.com Membership/
// Team + dub Project/ProjectUsers, scaled down. Three concerns:
//
//   1. Workspace: a collaboration unit. Slug is the workspace URL
//      piece (distinct from User.handle which is the booking URL
//      piece — booking still resolves through /h/<handle> for now).
//   2. Membership: user × workspace × role. Cascade delete from
//      either parent. The (workspaceId, userId) uniqueness keeps a
//      user from holding two memberships in one workspace.
//   3. Invitation: email-keyed, token-secured one-shot. Acceptance
//      converts the row into a Membership and stamps acceptedAt.
//
// Booking / Webhook / Audit are NOT yet workspace-scoped — they
// stay attached to the host User. A follow-up commit migrates those
// surfaces; this commit is the foundation.
model Workspace {
  id            String       @id @default(cuid())
  slug          String       @unique
  name          String
  ownerId       String
  owner         User         @relation("OwnedWorkspaces", fields: [ownerId], references: [id], onDelete: Cascade)
  memberships   Membership[]
  invitations   Invitation[]
  apiKeys       ApiKey[]
  subscription  Subscription?
  bookings      Booking[]
  // Event types (B2) — the bookable resource. Each EventType has a
  // host pool (EventTypeHost rows) that the round-robin algorithm
  // operates on. Backfill: every existing User got a singleton
  // EventType with themselves as a fixed host.
  eventTypes    EventType[]
  // Webhook subscriptions + audit history (B1). Both surfaces
  // moved from User-scoped to Workspace-scoped so OWNER/ADMIN can
  // see what their members configured.
  webhooks      WebhookSubscription[]
  bookingAudit  BookingAudit[]
  // B.PT82 — back-stack URLs holding the workspace's prior slug
  // resolve via this history table to a redirect, instead of 404'ing.
  // Append-only on rename; cascade-deletes with the workspace.
  slugHistory   WorkspaceSlugHistory[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([ownerId])
}

// Append-only ledger of every slug a Workspace has used in the past
// (B.PT82). When a workspace renames its slug, the prior slug is
// recorded here so a stale browser back-stack URL like
// `/workspaces/<oldSlug>/...` can resolve to a redirect to the
// current `/workspaces/<currentSlug>/...` instead of throwing
// `notFound()`.
//
// `oldSlug` is `@unique`. If a different workspace later claims that
// slug as its CURRENT slug, the helper that writes history rows
// proactively deletes the conflicting row — the new owner takes
// precedence over the prior tenant's redirect. Edge case but
// deterministic.
//
// Cascade delete on workspace delete: when a workspace is dropped,
// its slug history goes with it; we don't need to keep redirect
// targets pointing at a workspace that no longer exists.
model WorkspaceSlugHistory {
  id          Int       @id @default(autoincrement())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  oldSlug     String    @unique
  replacedAt  DateTime  @default(now())

  @@index([workspaceId])
}

// Workspace-scoped API key (B2). Tokens are generated server-side at
// create time, returned EXACTLY ONCE to the caller, and persisted as
// SHA-256 hash so a database snapshot doesn't reveal the secret. The
// 12-char `prefix` is the visible portion (shown in token list UI
// for easy identification — "oh_abcdefghi"); `tokenHash` is what
// verifyApiKey compares against in timing-safe fashion.
//
// `scopes` is a CSV of WORKSPACE_SCOPES values (src/lib/workspaces.ts).
// A token can carry a SUBSET of the creator's role scopes, so a tool
// that only needs to read bookings can be issued a key that can't
// touch members or webhooks. `revokedAt` is the off-switch — no
// row delete (preserves audit trail).
model ApiKey {
  id           String     @id @default(cuid())
  workspaceId  String
  workspace    Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name         String     // operator-supplied label, e.g. "ci-deploys"
  prefix       String     // first 12 chars of the token, indexed for fast lookup
  tokenHash    String     // sha256 hex of the FULL token
  scopes       String     // CSV — subset of WORKSPACE_SCOPES
  createdById  String     // userId who minted the key
  createdAt    DateTime   @default(now())
  lastUsedAt   DateTime?
  revokedAt    DateTime?
  expiresAt    DateTime?

  @@index([workspaceId])
  @@index([prefix])
}

model Membership {
  id           String          @id @default(cuid())
  workspaceId  String
  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         MembershipRole  @default(MEMBER)
  assignedAt   DateTime        @default(now())
  // The userId of the assigning admin/owner. Nullable for the
  // OWNER membership minted alongside the workspace itself (no
  // assigner exists at that moment).
  assignedBy   String?

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId, role])
}

model Invitation {
  id           String          @id @default(cuid())
  workspaceId  String
  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Recipient email — invitation isn't tied to an existing User
  // until accept lands (rallly's pattern: stranger-by-email,
  // bound-on-claim).
  email        String
  role         MembershipRole  @default(MEMBER)
  // 32 random bytes, hex-encoded — used in the accept URL.
  token        String          @unique
  // userId of the inviter. Required (workspace owner / admin).
  invitedBy    String
  expiresAt    DateTime
  acceptedAt   DateTime?
  createdAt    DateTime        @default(now())

  @@index([workspaceId])
  @@index([email])
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

// Calendar primitives (B3). cal.com's pattern (Credential +
// SelectedCalendar + per-provider adapter). Two stages of integration
// land here: (1) the user OAuths the provider once and we persist a
// CalendarCredential row with refresh + access tokens; (2) the user
// picks which of the calendars on that provider to read busy-times
// from (a single Google account can host many calendars — work,
// personal, etc.).
//
// Tokens are stored as plain text for now. cal.com encrypts them at
// rest via Prisma middleware; that's a separate hardening pass not
// in this commit's budget. .env should set CALENDAR_TOKEN_AT_REST_KEY
// when that lands.
//
// Push notifications + the CalendarSubscription state-machine
// (syncSubscribedAt, syncSubscribedErrorCount, circuit breaker) are
// deferred — busy-time read is fetched on-demand from the host page
// for now. Push channels land in a follow-up commit.

model CalendarCredential {
  id                  String              @id @default(cuid())
  userId              String
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider            CalendarProvider
  // Stable identifier for the upstream account (Google's `sub`,
  // Microsoft's `id`). One row per (user, provider, externalAccountId)
  // — a user can connect the same provider with different accounts.
  externalAccountId   String
  // Account-level metadata for UI rendering.
  externalAccountEmail String?
  accessToken         String
  refreshToken        String
  // Unix-ms expiry of the current access token. Refresh logic in
  // src/lib/calendar runs when now + 60s >= accessTokenExpiresAt.
  accessTokenExpiresAt DateTime
  scope               String              // CSV of granted OAuth scopes
  selectedCalendars   SelectedCalendar[]
  // Bookings whose event was written to this credential's calendar
  // (B2 two-way write). When the credential is deleted the FK
  // SetNull-cascades; the booking keeps its history without a
  // dangling external pointer.
  bookings            Booking[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@unique([userId, provider, externalAccountId])
  @@index([userId])
}

model SelectedCalendar {
  id                  String              @id @default(cuid())
  credentialId        String
  credential          CalendarCredential  @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  // The provider's calendar identifier. Google uses email-shaped
  // strings ("primary", "user@example.com"); Microsoft uses GUIDs.
  externalCalendarId  String
  // Display name + role for UI. Stored on selection so the picker
  // doesn't re-fetch the calendar list for every render.
  summary             String
  // Whether this is the user's default calendar in the provider —
  // useful for marking "main" in the UI.
  isPrimary           Boolean             @default(false)
  createdAt           DateTime            @default(now())

  @@unique([credentialId, externalCalendarId])
  @@index([credentialId])
}

enum CalendarProvider {
  GOOGLE
  MICROSOFT
}

// Automation rule (B4). cal.com's pattern (Workflow + WorkflowStep)
// shrunk to a single row per rule — Officehours doesn't have event
// types yet, so the rule fans out to every booking against the host.
//
// Three axes:
//   • trigger: which booking event fires the rule.
//     BEFORE_EVENT  — N minutes before slotStart.
//     EVENT_CREATED — when bookings.create lands.
//     EVENT_CANCELLED / EVENT_RESCHEDULED — when those mutations
//       fire respectively.
//   • offsetMinutes: only meaningful for BEFORE_EVENT. Positive
//     values fire BEFORE the slot. Constrained to 0–10080 (one
//     week) to keep the cron horizon bounded.
//   • action: what to dispatch. Translates to an existing emailSend
//     or webhookDelivery Task — the workflow engine doesn't add a
//     new Task type.
//
// `template` is the email template name when action is EMAIL_*.
// Currently free-text validated against the registry's TemplateName
// union at dispatch time — invalid template = workflow fails on
// dispatch, not on save (so adding a new template doesn't break
// rows that reference it).
//
// Booking / webhook / audit surfaces stay user-centric for now —
// matches B1's deferral chain.
model Workflow {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  trigger        WorkflowTrigger
  // Only meaningful when trigger == BEFORE_EVENT. Positive minutes
  // before slotStart. Other triggers ignore this field.
  offsetMinutes  Int              @default(0)
  action         WorkflowAction
  // Email template name (TemplateName) when action is EMAIL_*.
  // Optional for WEBHOOK_FIRE.
  template       String?
  // Webhook event name when action is WEBHOOK_FIRE. Optional for
  // EMAIL_*. Future: a separate webhookEvent enum constraint.
  webhookEvent   String?
  active         Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([userId, active])
  @@index([trigger, active])
}

enum WorkflowTrigger {
  BEFORE_EVENT
  EVENT_CREATED
  EVENT_CANCELLED
  EVENT_RESCHEDULED
}

enum WorkflowAction {
  EMAIL_VISITOR
  EMAIL_HOST
  WEBHOOK_FIRE
}

// Workspace billing (C2). One subscription per workspace, mirrored
// from Stripe via the webhook handler at /api/stripe/webhook. The
// `plan` field is the source of truth for plan-gating decisions
// — server-side checks read it and consult PLAN_FEATURES (in
// src/lib/billing.ts) to decide whether a workspace can do X.
//
// Pattern reference: dub /apps/web/app/(ee)/api/stripe/webhook/
// route.ts:15-92 — event-type switch with signature verification +
// idempotency on event.id.
model Subscription {
  id                    String         @id @default(cuid())
  workspaceId           String         @unique
  workspace             Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Stripe customer + subscription identifiers, persisted at first
  // sync. Nullable so a workspace can exist without ever having
  // touched the billing surface (free plan default).
  stripeCustomerId      String?        @unique
  stripeSubscriptionId  String?        @unique
  plan                  PlanTier       @default(FREE)
  status                SubscriptionStatus @default(ACTIVE)
  // ISO instants; null when not on a paid plan.
  currentPeriodEnd      DateTime?
  cancelAtPeriodEnd     Boolean        @default(false)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([stripeCustomerId])
}

// Idempotency log for Stripe webhooks. Stripe retries on 5xx; we
// dedup by event.id so re-processing the same event never
// double-applies state. Pattern from dub's webhook handler.
model StripeEvent {
  id          String   @id // Stripe's event.id ("evt_…")
  type        String
  processedAt DateTime @default(now())
}

enum PlanTier {
  FREE
  PRO
  TEAM
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}
