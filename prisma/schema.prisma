generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                   String              @id @default(cuid())
  name                 String?
  email                String              @unique
  emailVerified        DateTime?
  image                String?
  passwordHash         String?
  invalidLoginAttempts Int                 @default(0)
  handle               String?             @unique
  bio                  String?
  timezone             String              @default("UTC")
  onboardingDismissed  Boolean             @default(false)
  onboardingManualSteps String             @default("[]")
  availabilityRanges   AvailabilityRange[]
  accounts             Account[]
  sessions             Session[]
  Authenticator        Authenticator[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  bookings             Booking[]
  webhooks             WebhookSubscription[]
  features             UserFeatures[]
  ownedWorkspaces      Workspace[]         @relation("OwnedWorkspaces")
  memberships          Membership[]
  calendarCredentials  CalendarCredential[]
  workflows            Workflow[]
  eventTypeHosts       EventTypeHost[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?
  user                 User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

model Booking {
  id           Int      @id @default(autoincrement())
  publicUid    String   @unique @default(cuid())
  host         User     @relation(fields: [hostId], references: [id], onDelete: Cascade)
  hostId       String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId  String
  visitorName  String
  visitorEmail String
  question     String?
  slotStart    DateTime
  slotEnd      DateTime
  visitorTimezone String?
  rescheduledFromUid String?
  referrer     String?
  idempotencyKey String? @unique
  eventTypeId  String?
  eventType    EventType? @relation(fields: [eventTypeId], references: [id], onDelete: SetNull)
  externalCalendarEventId      String?
  externalCalendarCredentialId String?
  externalCalendarCredential   CalendarCredential? @relation(fields: [externalCalendarCredentialId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  deleted      Boolean  @default(false)
  deletedAt    DateTime?

  @@index([hostId, slotStart, deleted])
  @@index([deleted, deletedAt])
  @@index([workspaceId, slotStart])
  @@index([eventTypeId, slotStart])
}

model EventType {
  id           String          @id @default(cuid())
  workspaceId  String
  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  slug         String
  name         String
  durationMins Int             @default(15)
  durationMinsList String       @default("[]")
  hosts        EventTypeHost[]
  bookings     Booking[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([workspaceId, slug])
  @@index([workspaceId])
}

model EventTypeHost {
  id                String    @id @default(cuid())
  eventTypeId       String
  eventType         EventType @relation(fields: [eventTypeId], references: [id], onDelete: Cascade)
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  isFixed           Boolean   @default(false)
  priority          Int       @default(2)
  weight            Int       @default(1)
  recentAssignments Int       @default(0)
  createdAt         DateTime  @default(now())

  @@unique([eventTypeId, userId])
  @@index([userId])
}

model BookingAudit {
  id          Int                 @id @default(autoincrement())
  bookingUid  String              // intentionally NOT FK
  workspaceId String?
  workspace   Workspace?          @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  actor       AuditActor
  action      BookingAuditAction
  data        Json                // snapshot of the new state
  operationId String
  createdAt   DateTime            @default(now())

  @@index([bookingUid])
  @@index([operationId])
  @@index([workspaceId, createdAt])
}

enum AuditActor {
  VISITOR
  HOST
  SYSTEM
}

enum BookingAuditAction {
  CREATED
  CONFIRMED
  CANCELLED
  RESCHEDULED_FROM
  RESCHEDULED_TO
}

model Feature {
  slug        String      @id
  enabled     Boolean     @default(false)
  description String?
  type        FeatureType @default(RELEASE)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  assignments UserFeatures[]

  @@index([enabled])
}

model UserFeatures {
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  feature     Feature @relation(fields: [featureSlug], references: [slug], onDelete: Cascade)
  featureSlug String
  assignedAt  DateTime @default(now())
  assignedBy  String?

  @@id([userId, featureSlug])
  @@index([featureSlug])
}

enum FeatureType {
  RELEASE      // staged rollout of a new feature
  EXPERIMENT   // A/B test gate
  OPERATIONAL  // structural toggle (caching, batching)
  KILL_SWITCH  // emergency off-switch for an existing feature
  PERMISSION   // long-lived gate per role / plan / cohort
}

model WebhookSubscription {
  id            Int      @id @default(autoincrement())
  publicUid     String   @unique @default(cuid())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId   String
  subscriberUrl String
  secret        String   // hex-encoded 32 random bytes; HMAC SHA-256 key
  events        String   // CSV: "booking.created,booking.confirmed"
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, active])
  @@index([workspaceId, active])
}

model Task {
  id                   Int       @id @default(autoincrement())
  type                 String    // "webhookDelivery" for now
  payload              String    // JSON.stringify of { webhookSubscriptionId, event, body }
  scheduledAt          DateTime  @default(now())
  succeededAt          DateTime?
  attempts             Int       @default(0)
  maxAttempts          Int       @default(3)
  lastError            String?
  lastFailedAttemptAt  DateTime?
  lastResponseStatus   Int?
  referenceUid         String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([referenceUid, type])
  @@index([succeededAt])
  @@index([scheduledAt, succeededAt])
}

model AvailabilityRange {
  id        Int       @id @default(autoincrement())
  userId    String
  dayOfWeek DayOfWeek
  startTime String
  endTime   String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dayOfWeek])
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model Workspace {
  id            String       @id @default(cuid())
  slug          String       @unique
  name          String
  ownerId       String
  owner         User         @relation("OwnedWorkspaces", fields: [ownerId], references: [id], onDelete: Cascade)
  memberships   Membership[]
  invitations   Invitation[]
  apiKeys       ApiKey[]
  subscription  Subscription?
  bookings      Booking[]
  eventTypes    EventType[]
  webhooks      WebhookSubscription[]
  bookingAudit  BookingAudit[]
  slugHistory   WorkspaceSlugHistory[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([ownerId])
}

model WorkspaceSlugHistory {
  id          Int       @id @default(autoincrement())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  oldSlug     String    @unique
  replacedAt  DateTime  @default(now())

  @@index([workspaceId])
}

model ApiKey {
  id           String     @id @default(cuid())
  workspaceId  String
  workspace    Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name         String     // operator-supplied label, e.g. "ci-deploys"
  prefix       String     // first 12 chars of the token, indexed for fast lookup
  tokenHash    String     // sha256 hex of the FULL token
  scopes       String     // CSV — subset of WORKSPACE_SCOPES
  createdById  String     // userId who minted the key
  createdAt    DateTime   @default(now())
  lastUsedAt   DateTime?
  revokedAt    DateTime?
  expiresAt    DateTime?

  @@index([workspaceId])
  @@index([prefix])
}

model Membership {
  id           String          @id @default(cuid())
  workspaceId  String
  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         MembershipRole  @default(MEMBER)
  assignedAt   DateTime        @default(now())
  assignedBy   String?

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId, role])
}

model Invitation {
  id           String          @id @default(cuid())
  workspaceId  String
  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email        String
  role         MembershipRole  @default(MEMBER)
  token        String          @unique
  invitedBy    String
  expiresAt    DateTime
  acceptedAt   DateTime?
  createdAt    DateTime        @default(now())

  @@index([workspaceId])
  @@index([email])
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model CalendarCredential {
  id                  String              @id @default(cuid())
  userId              String
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider            CalendarProvider
  externalAccountId   String
  externalAccountEmail String?
  accessToken         String
  refreshToken        String
  accessTokenExpiresAt DateTime
  scope               String              // CSV of granted OAuth scopes
  selectedCalendars   SelectedCalendar[]
  bookings            Booking[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@unique([userId, provider, externalAccountId])
  @@index([userId])
}

model SelectedCalendar {
  id                  String              @id @default(cuid())
  credentialId        String
  credential          CalendarCredential  @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  externalCalendarId  String
  summary             String
  isPrimary           Boolean             @default(false)
  createdAt           DateTime            @default(now())

  @@unique([credentialId, externalCalendarId])
  @@index([credentialId])
}

enum CalendarProvider {
  GOOGLE
  MICROSOFT
}

model Workflow {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  trigger        WorkflowTrigger
  offsetMinutes  Int              @default(0)
  action         WorkflowAction
  template       String?
  webhookEvent   String?
  active         Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([userId, active])
  @@index([trigger, active])
}

enum WorkflowTrigger {
  BEFORE_EVENT
  EVENT_CREATED
  EVENT_CANCELLED
  EVENT_RESCHEDULED
}

enum WorkflowAction {
  EMAIL_VISITOR
  EMAIL_HOST
  WEBHOOK_FIRE
}

model Subscription {
  id                    String         @id @default(cuid())
  workspaceId           String         @unique
  workspace             Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stripeCustomerId      String?        @unique
  stripeSubscriptionId  String?        @unique
  plan                  PlanTier       @default(FREE)
  status                SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd      DateTime?
  cancelAtPeriodEnd     Boolean        @default(false)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([stripeCustomerId])
}

model StripeEvent {
  id          String   @id // Stripe's event.id ("evt_…")
  type        String
  processedAt DateTime @default(now())
}

enum PlanTier {
  FREE
  PRO
  TEAM
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}
